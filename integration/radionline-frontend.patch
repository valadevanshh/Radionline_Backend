diff -ruN -x node_modules -x .next -x package-lock.json -x tsconfig.tsbuildinfo -x next-env.d.ts a/lib/study-views.test.ts b/lib/study-views.test.ts
--- a/lib/study-views.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/study-views.test.ts	2026-11-07 18:42:43.120007170 +0000
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { explicitStudyViews } from './study-views';
+
+test('one selected view is one view no matter how many files were picked', () => {
+  const views = explicitStudyViews({ viewList: ['PA'] });
+  assert.deepEqual(views, ['PA']);
+  assert.equal(views.length, 1);
+});
+
+test('AP and LATERAL are two views even when a single file was uploaded', () => {
+  assert.deepEqual(explicitStudyViews({ viewList: ['AP', 'LATERAL'] }), ['AP', 'LATERAL']);
+});
+
+test('AP/LAT is kept as the selected combination label', () => {
+  assert.deepEqual(explicitStudyViews({ viewList: ['AP/LAT'] }), ['AP/LAT']);
+});
+
+test('a legacy single view field is sent when the multi-select is empty', () => {
+  assert.deepEqual(explicitStudyViews({ viewList: [], view: 'AP/LATERAL' }), ['AP/LATERAL']);
+});
+
+test('no selected view sends nothing for the server to parse from the study name', () => {
+  assert.deepEqual(explicitStudyViews({ viewList: [], view: '  ' }), []);
+});
diff -ruN -x node_modules -x .next -x package-lock.json -x tsconfig.tsbuildinfo -x next-env.d.ts a/lib/study-views.ts b/lib/study-views.ts
--- a/lib/study-views.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/study-views.ts	2026-11-07 18:42:41.608008209 +0000
@@ -0,0 +1,12 @@
+/** Explicit projection labels chosen on the upload form.
+
+Image files are not views. Billing uses this list, not how many files were uploaded.
+*/
+export function explicitStudyViews(study: { viewList?: string[] | null; view?: string | null }): string[] {
+  const list = Array.isArray(study.viewList)
+    ? study.viewList.map((v) => String(v || '').trim()).filter(Boolean)
+    : [];
+  if (list.length) return list;
+  const one = String(study.view || '').trim();
+  return one ? [one] : [];
+}
