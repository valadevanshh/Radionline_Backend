+"""
+
+_SIDE_RE = re.compile(r"\s*\((LEFT|RIGHT|BOTH)\)\s*$", re.I)
+
+# Whole-token synonyms only. "LATERAL DECUBITUS" is not the same view as "LAT".
+_SYNONYMS = {
+    "LAT": "LAT",
+    "LATERAL": "LAT",
+    "OBL": "OBLIQUE",
+    "OBLIQUE": "OBLIQUE",
+}
+
+
+def _norm(value: str) -> str:
+    text = str(value or "").upper().replace("º", "°").replace("—", "-")
+    text = text.replace("\u00a0", " ")
+    text = re.sub(r"\s*/\s*", " / ", text)
+    text = re.sub(r"\s*&\s*", " & ", text)
+    text = re.sub(r"\s+", " ", text).strip()
+    return text
+
+
+def _canon_token(token: str) -> str:
+    token = _norm(token)
+    return _SYNONYMS.get(token, token)
+
+
+def _load_names(block: str) -> List[str]:
+    return [ln.strip() for ln in block.splitlines() if ln.strip()]
+
+
+_BODY_SORTED = tuple(sorted({_norm(n) for n in _load_names(_BODY_PART_NAMES)}, key=len, reverse=True))
+_KNOWN_VIEWS = frozenset(_canon_token(n) for n in _load_names(_VIEW_NAMES))
+
+
+def _split_combo(label: str) -> List[str]:
+    """Split on / or & outside parentheses. AP SUPINE (no separator) stays one label."""
+    parts: List[str] = []
+    buf: List[str] = []
+    depth = 0
+    for ch in label:
+        if ch == "(":
+            depth += 1
+            buf.append(ch)
+        elif ch == ")":
+            depth = max(0, depth - 1)
+            buf.append(ch)
+        elif depth == 0 and ch in "/&":
+            parts.append("".join(buf).strip())
+            buf = []
+        else:
+            buf.append(ch)
+    tail = "".join(buf).strip()
+    if tail:
+        parts.append(tail)
+    return [p for p in parts if p]
+
+
+def _expand_label(label: str) -> List[str]:
+    """One selected label -> one or more canonical views.
+
+    A slash or ampersand combination counts as several views only when every
+    piece is a known projection (AP/LAT, AP/LATERAL, PA & LATERAL). Otherwise
+    the whole label is one explicit view, including a custom name.
+    """
+    text = _norm(label)
+    if not text:
+        return []
+    pieces = _split_combo(text)
+    if len(pieces) >= 2:
+        canon = [_canon_token(p) for p in pieces]
+        if all(c in _KNOWN_VIEWS for c in canon):
+            return _unique(canon)
+    return [_canon_token(text)]
+
+
+def _unique(labels: Iterable[str]) -> List[str]:
+    out: List[str] = []
+    seen = set()
+    for label in labels:
+        if not label or label in seen:
+            continue
+        seen.add(label)
+        out.append(label)
+    return out
+
+
+def _body_prefix(text: str) -> str:
+    for name in _BODY_SORTED:
+        if text == name or text.startswith(name + " "):
+            return name
+    return ""
+
+
+def _parse_view_expression(expr: str) -> List[str]:
+    expr = _norm(expr)
+    if not expr:
+        return []
+    # Whole remainder is one known projection, including multi-word names
+    # ("AP SUPINE"). Spaces are not extra views.
+    whole = _canon_token(expr)
+    if whole in _KNOWN_VIEWS and len(_split_combo(expr)) == 1:
+        return [whole]
+    pieces = _split_combo(expr)
+    if len(pieces) >= 2:
+        canon = [_canon_token(p) for p in pieces]
+        if all(c in _KNOWN_VIEWS for c in canon):
+            return _unique(canon)
+    return []
+
+
+def infer_views_from_body_part(body_part: str) -> List[str]:
+    """Views explicitly present in a stored study name. [] when none are explicit."""
+    text = _norm(body_part)
+    text = _SIDE_RE.sub("", text).strip()
+    if not text:
+        return []
+    prefix = _body_prefix(text)
+    if not prefix:
+        return _parse_view_expression(text)
+    remainder = text[len(prefix):].strip()
+    if not remainder:
+        return []
+    return _parse_view_expression(remainder)
+
+
+def explicit_view_labels(views: Optional[Sequence]) -> List[str]:
+    if not isinstance(views, (list, tuple)):
+        return []
+    labels: List[str] = []
+    for item in views:
+        if not isinstance(item, str):
+            continue
+        labels.extend(_expand_label(item))
+    return _unique(labels)
+
+
+def billable_view_labels(*, body_part: str = "", explicit_views: Optional[Sequence] = None) -> List[str]:
+    """Ordered unique views to price for one study.
+
+    There is no image-count argument. Missing explicit metadata counts as one unit.
+    """
+    chosen = explicit_view_labels(explicit_views)
+    if chosen:
+        return chosen
+    inferred = infer_views_from_body_part(body_part)
+    if inferred:
+        return inferred
+    return ["STUDY"]
+
+
+def billable_view_count(*, body_part: str = "", explicit_views: Optional[Sequence] = None) -> int:
+    return len(billable_view_labels(body_part=body_part, explicit_views=explicit_views))
diff --git a/scripts/preview_open_invoice_adjustments.py b/scripts/preview_open_invoice_adjustments.py
new file mode 100644
index 0000000..8063a08
--- /dev/null
+++ b/scripts/preview_open_invoice_adjustments.py
@@ -0,0 +1,61 @@
+"""Read-only preview of open-invoice deletion adjustments.
+
+Does not UPDATE, DELETE, or INSERT. Does not reprice stored line amounts.
+Does not touch prepaid wallet ledgers.
+
+Already billed studies keep the rupee amount from sign-off. View-count pricing
+applies to new sign-offs. Deleted patients are omitted from open (not paid,
+not locked) invoices when those invoices are read; paid and locked invoices
+stay as the settlement record.
+
+Take a database backup before the first production read of invoices after
+deploy, because that read persists the open-invoice exclusion.
+
+Usage (against a database you choose; this script never writes):
+
+    python scripts/preview_open_invoice_adjustments.py
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+if ROOT not in sys.path:
+    sys.path.insert(0, ROOT)
+
+from app.billing import (  # noqa: E402
+    preview_open_invoice_deletion_adjustments,
+    preview_view_count_deltas,
+)
+from app.database import SessionLocal  # noqa: E402
+
+
+def main() -> int:
+    db = SessionLocal()
+    try:
+        deletions = preview_open_invoice_deletion_adjustments(db)
+        deltas = preview_view_count_deltas(db)
+        # Prove this process did not flush writes.
+        db.rollback()
+    finally:
+        db.close()
+    report = {
+        "writes": False,
+        "deletionAdjustments": deletions,
+        "viewCountDeltasNotApplied": deltas,
+        "notes": [
+            "action preserve: paid or locked invoice, totals and rows stay.",
+            "action exclude_on_read: open invoice will drop these lines from totals and detail rows; the line rows remain with status EXCLUDED_DELETED.",
+            "viewCountDeltasNotApplied is informational only. Do not rewrite stored amounts from it.",
+            "Prepaid wallet CHARGE rows are not credited by this change.",
+        ],
+    }
+    json.dump(report, sys.stdout, indent=2)
+    sys.stdout.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
