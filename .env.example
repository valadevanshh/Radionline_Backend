# PostgreSQL — Azure-style remote (host:port)
# DATABASE_URL=postgresql://radionline:CHANGE_ME@91.108.105.182:5432/radionline
#
# Same VPS as API (recommended in production):
DATABASE_URL=postgresql://radionline:CHANGE_ME@127.0.0.1:5432/radionline

ENVIRONMENT=production
ALLOW_SQLITE_FALLBACK=false

JWT_SECRET=change-me-to-a-long-random-string

# First super admin, created only when the users table is empty.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# On the VPS, files are written to local disk:
FILE_STORAGE_TRANSPORT=local
FILE_STORAGE_ROOT=/var/www/radionline/storage
FILE_PUBLIC_BASE_URL=http://YOUR_VPS_IP:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# On a developer PC, keep the same database and send files to that disk over SFTP:
# FILE_STORAGE_TRANSPORT=sftp
# FILE_SFTP_HOST=YOUR_VPS_IP
# FILE_SFTP_USER=root
# FILE_SFTP_PASSWORD=
# FILE_SFTP_ROOT=/var/www/radionline/storage
# FILE_PUBLIC_BASE_URL=http://YOUR_VPS_IP:8000
